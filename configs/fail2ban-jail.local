# fail2ban-jail.local — Linux Server Hardening v3.0
# Copy to /etc/fail2ban/jail.local

[DEFAULT]
bantime   = 3600
findtime  = 600
maxretry  = 3
banaction = iptables-multiport
backend   = systemd

[sshd]
enabled  = true
port     = 2222
filter   = sshd
logpath  = /var/log/auth.log
maxretry = 3
bantime  = 7200

[sshd-ddos]
enabled  = true
port     = 2222
filter   = sshd-ddos
logpath  = /var/log/auth.log
maxretry = 6
bantime  = 86400

[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
banaction = iptables-allports
bantime  = 604800
findtime = 86400
maxretry = 3
